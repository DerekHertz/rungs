{
  "name": "systems-to-streets",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a changing codebase into a navigable visual system, from the big picture down to the details of a change.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "streets": "node src/cli.ts",
    "prelint": "node scripts/ensure-deps.mjs",
    "lint": "eslint .",
    "pretypecheck": "node scripts/ensure-deps.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/page",
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "vitest run",
    "bench": "node src/bench-cli.ts",
    "perf": "node perf/extract.ts"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "micromark": "4.0.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "playwright-core": "1.64.1",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
